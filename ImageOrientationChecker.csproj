<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ImageOrientationChecker</RootNamespace>
    <AssemblyName>ImageOrientationChecker</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>

    <!-- The script sets its own [assembly: AssemblyVersion("1.0.*")], so don't generate one.
         Wildcard versions also require non-deterministic builds. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>

    <!-- Keep the old output folders (bin\debug, bin\release) without a net48 subfolder. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Only compile the script itself; the default globs would also pick up tests\. -->
    <EnableDefaultItems>false</EnableDefaultItems>

    <!-- Folder holding the ESAPI assemblies. Override for other Eclipse versions, e.g.
         dotnet build -p:EsapiPath="C:\Program Files (x86)\Varian\RTM\16.1\esapi\API" -->
    <EsapiPath Condition="'$(EsapiPath)' == ''">C:\Program Files (x86)\Varian\RTM\18.1\esapi\API</EsapiPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ImageOrientationChecker.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="VMS.TPS.Common.Model.API">
      <HintPath>$(EsapiPath)\VMS.TPS.Common.Model.API.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VMS.TPS.Common.Model.Types">
      <HintPath>$(EsapiPath)\VMS.TPS.Common.Model.Types.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the project build without the .NET Framework 4.8 targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
